# =========================================================================
# Ronin Intelligence Platform Environment Configuration Template
# Copy this file to '.env' inside the 'backend' folder and update values.
# =========================================================================

# --- 1. LOCAL MODE (Default) ---
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=lm-studio
# GENERAL_MODEL=meta-llama-3-8b-instruct
# DEEP_MODEL=meta-llama-3-8b-instruct
# CODE_MODEL=meta-llama-3-8b-instruct

# --- 2. OPENAI CLOUD MODE ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# GENERAL_MODEL=gpt-4o-mini
# DEEP_MODEL=gpt-4o
# CODE_MODEL=gpt-4o

# --- 3. DEEPSEEK MODE ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# GENERAL_MODEL=deepseek-chat
# DEEP_MODEL=deepseek-chat
# CODE_MODEL=deepseek-coder

# --- 4. OPENROUTER MODE ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# GENERAL_MODEL=google/gemini-2.0-flash-exp:free
# DEEP_MODEL=openai/gpt-4o
# CODE_MODEL=anthropic/claude-3.5-sonnet

# --- 5. GOOGLE GEMINI MODE (OpenAI Compatible) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIzaSyYourGeminiApiKeyHere
# GENERAL_MODEL=gemini-2.5-flash
# DEEP_MODEL=gemini-2.5-pro
# CODE_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-2
